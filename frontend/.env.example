# Analytics Configuration
# Choose one provider: "ga4" | "plausible" | "umami" | "none"
VITE_ANALYTICS_PROVIDER=none

# Google Analytics 4 (if using ga4 provider)
# Get measurement ID from https://analytics.google.com
VITE_GA_MEASUREMENT_ID=

# Plausible Analytics (if using plausible provider)
# Self-hosted or plausible.io domain
VITE_PLAUSIBLE_DOMAIN=

# Umami Analytics (if using umami provider)
# Get website ID from https://cloud.umami.is or self-hosted instance
VITE_UMAMI_WEBSITE_ID=

# Sentry Error Monitoring (optional - get DSN from https://sentry.io)
VITE_SENTRY_DSN=

# Google Identity Services OAuth 2.0 Web Client ID.
# Gunakan Client ID yang sama dengan GOOGLE_CLIENT_ID pada backend.
VITE_GOOGLE_CLIENT_ID=

# WhatsApp Contact Number (format: country_code + number without leading 0)
# Example: 62 (Indonesia) + 85794801890 = 6285794801890
VITE_WHATSAPP_NUMBER=6285794801890

# API URL (backend root URL, without /api)
# Example: https://api.nakicode.com
# Leave empty only when backend is served from the same origin as frontend.
VITE_API_URL=

# Canonical public frontend origin used by SEO metadata.
VITE_SITE_URL=https://nakicode.com
VITE_GOOGLE_SITE_VERIFICATION=

# Public origins used by scripts/generate-sitemap.mjs during production builds.
SITE_URL=https://nakicode.com
SITEMAP_API_URL=
