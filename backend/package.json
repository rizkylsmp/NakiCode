{
  "name": "backend",
  "version": "0.9.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "vitest run --pool=forks --maxWorkers=1",
    "start": "node dist/server.js",
    "backup:db": "tsx src/scripts/backup-database.ts",
    "backup:list": "tsx src/scripts/backup-database.ts --list",
    "content:publish-blog": "tsx src/scripts/publish-blog-content.ts",
    "content:refresh-blog-covers": "tsx src/scripts/refresh-blog-covers.ts",
    "outreach:migrate": "tsx src/scripts/outreach-cycle.ts migrate",
    "outreach:sync": "tsx src/scripts/outreach-cycle.ts sync",
    "outreach:dispatch": "tsx src/scripts/outreach-cycle.ts dispatch",
    "outreach:check": "tsx src/scripts/outreach-cycle.ts dry-run",
    "outreach:status": "tsx src/scripts/outreach-cycle.ts status",
    "outreach:format-drafts": "tsx src/scripts/outreach-format-drafts.ts",
    "email:retry-orders": "tsx src/scripts/retry-order-emails.ts",
    "payment:webhook:sandbox": "tsx src/scripts/midtrans-webhook-sandbox.ts",
    "migrate": "npm run migrate:sql",
    "migrate:status": "npm run migrate:sql:status",
    "migrate:create": "npm run migrate:sql:create --",
    "migrate:sql": "tsx src/scripts/migrate.ts",
    "migrate:sql:status": "tsx src/scripts/migrate.ts status",
    "migrate:sql:create": "tsx src/scripts/migrate.ts create",
    "office:worker": "tsx src/scripts/digital-office-worker.ts",
    "office:telegram": "tsx src/scripts/digital-office-telegram.ts",
    "office:telegram:setup": "powershell -NoProfile -File scripts/setup-office-telegram.ps1",
    "office:hermes": "tsx src/scripts/digital-office-worker.ts --engine hermes",
    "office:hermes:setup": "powershell -NoProfile -File scripts/setup-office-hermes.ps1"
  },
  "dependencies": {
    "@sentry/node": "^10.58.0",
    "bullmq": "^5.78.1",
    "cloudinary": "^2.10.0",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "multer": "^2.1.1",
    "mysql2": "latest",
    "nodemailer": "^8.0.11",
    "pdfkit": "^0.19.1",
    "rate-limit-redis": "^5.0.0",
    "sharp": "^0.35.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/multer": "^2.1.0",
    "@types/node": "latest",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/zxcvbn": "^4.4.5",
    "supertest": "^7.2.2",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "^4.1.8"
  }
}
